# Copy this file to `local.properties` and set the values for your machine.
# `sdk.dir` is usually created by Android Studio in your local file and is not meant to be committed.

# Application API base URL used at build time.
# Replace this with your machine's IP or deployed backend URL.
base_url=http://192.168.1.3:8080/api/

# Gemini API key used at build time.
# Replace this with your Gemini API key.
gemini_api_key=YOUR_GEMINI_API_KEY_HERE

